// Isolated fc_v4_board_top constraints, GW5AT-LV138PG484AC1/I0 version C.
// clk and actuator mappings are exact active CST subset. UART verified separately.
IO_LOC "clk" W19;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// CH9102F TXD pin21 -> UART_RXD -> FPGA L21, VIO=VCC3P3.
IO_LOC "UART_RXD" L21;
IO_PORT "UART_RXD" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// FPGA M21 -> UART_TXD -> CH9102F RXD pin20.
IO_LOC "UART_TXD" M21;
IO_PORT "UART_TXD" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
