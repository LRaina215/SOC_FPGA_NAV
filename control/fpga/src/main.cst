// ACG750 GW5AT-138C PG484：50MHz 时钟及 S0 复位按键。
IO_LOC "clk" W19;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "reset_n" D21;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// GPIO0/P11 排针物理序号，非 FPGA 封装数字脚号。
// OLED SCL（用户命名 sck）：P11 pin5 -> GPIO0_4 -> F19。
IO_LOC "sck" F19;
IO_PORT "sck" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// OLED SDA：P11 pin6 -> GPIO0_5 -> F20。
IO_LOC "sda" F20;
IO_PORT "sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// OLED 驱动使用开漏输出；正常 I2C 时序仍需模块/外部 3.3V 上拉电阻。

// BMI088 I2C: SDA=P11-7(GPIO0_6/F18), SCL=P11-8(GPIO0_7/E18).
IO_LOC "BMI088_SDA" F18;
IO_PORT "BMI088_SDA" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "BMI088_SCL" E18;
IO_PORT "BMI088_SCL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 520 AB encoder pins copied from the verified competition project.
IO_LOC "M1_ENCA" D14;
IO_PORT "M1_ENCA" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "M1_ENCB" F13;
IO_PORT "M1_ENCB" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "M2_ENCA" D15;
IO_PORT "M2_ENCA" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "M2_ENCB" F14;
IO_PORT "M2_ENCB" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 520 motor drive outputs, copied from the verified original project.
IO_LOC "M1_DIR1" B20;
IO_PORT "M1_DIR1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M1_DIR2" B17;
IO_PORT "M1_DIR2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M1_PWM" D17;
IO_PORT "M1_PWM" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M2_DIR1" B18;
IO_PORT "M2_DIR1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M2_DIR2" A20;
IO_PORT "M2_DIR2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M2_PWM" C17;
IO_PORT "M2_PWM" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Calibrated servos:1 LH,2 LK,3 RH,4 RK; P11 pins1..4.
IO_LOC "SERVO1" C18;
IO_PORT "SERVO1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "SERVO2" C19;
IO_PORT "SERVO2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "SERVO3" E19;
IO_PORT "SERVO3" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "SERVO4" D19;
IO_PORT "SERVO4" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// IR receiver pin copied from reference main.cst; idle-high NEC signal.
IO_LOC "IRIN" A21;
IO_PORT "IRIN" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Existing UART wiring: USB module RX <- P11-40; module TX -> P11-39.
IO_LOC "UART_TXD" A16;
IO_PORT "UART_TXD" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "UART_RXD" A15;
IO_PORT "UART_RXD" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
