+static uint32_t anchor_diag[6];
+void pose_anchor_diagnostics(uint32_t out[6]) {for(int i=0;i<6;i++)out[i]=anchor_diag[i];}
+
+/* Optional fallback uses explicitly remembered static contacts, never calls
+ * them fresh. Two confirmed wheel-center tiles plus fresh front references
+ * must agree under the unchanged20mm transition contract. */
+static bool anchor_contacts(pose_est_t *p,const nav_pose_t *at,int hw,int gain) {
+    hal_map_info_t mi,after;if(!hal_map_info(&mi) || !mi.inv_res)return false;
+    hal_support_t contact[2],front[2];uint32_t epoch=hal_time_us()/200000u;
+    for(int i=0;i<2;i++) {
+        int32_t x,y;pose_body_to_odom(at,0,i?-hw:hw,&x,&y);
+        if(!hal_map_support(x,y,&contact[i]) || contact[i].seq!=mi.seq || contact[i].count<2 || contact[i].hi-contact[i].lo+2>20) {anchor_diag[3]=3;return false;}
+        unsigned sx=(unsigned)(((int64_t)x*mi.inv_res)>>14)&3,sy=(unsigned)(((int64_t)y*mi.inv_res)>>14)&3;
+        if(!(contact[i].coverage&(1u<<(sy*4+sx)))){anchor_diag[3]=4;return false;}
+        pose_body_to_odom(at,60,i?-hw:hw,&x,&y);
+        if(!hal_map_support(x,y,&front[i]) || front[i].seq!=mi.seq || front[i].retained_stale || front[i].age>60 ||
+           support_transition(contact[i].lo,contact[i].hi,front[i].lo,front[i].hi,20,1)!=SUPPORT_PASS) {anchor_diag[3]=5;return false;}
+        unsigned fx=(unsigned)(((int64_t)x*mi.inv_res)>>14)&3,fy=(unsigned)(((int64_t)y*mi.inv_res)>>14)&3;
+        if(!(front[i].coverage&(1u<<(fy*4+fx)))){anchor_diag[3]=4;return false;}
+    }
+    if(support_transition(contact[0].lo,contact[0].hi,contact[1].lo,contact[1].hi,57,1)!=SUPPORT_PASS ||
+       !hal_map_info(&after) || after.seq!=mi.seq || after.cx!=mi.cx || after.cy!=mi.cy || after.inv_res!=mi.inv_res || hal_time_us()/200000u!=epoch) {anchor_diag[3]=6;return false;}
+    int target=((int)contact[0].lo+contact[0].hi+contact[1].lo+contact[1].hi)/4;
+    int e=target-p->cur.z;if(e>150 || e< -150){anchor_diag[3]=7;return false;}
+    int delta=nav_clamp32(e*nav_min32(gain,32)/256,-2,2);
+    pose_correct_delta(p,0,0,delta,0);anchor_diag[1]++;anchor_diag[3]=1;anchor_diag[4]=target;anchor_diag[5]=delta;return true;
+}
 
