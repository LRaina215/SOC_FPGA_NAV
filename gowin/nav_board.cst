// ACX750-GW5A138 导航子系统单板联调约束（引脚来自《ACX750-GW5A138开发板管脚信息表.xlsx》
// 与厂家例程 eth_udp_lookback_rgmii.cst）。IMU 串口引脚为扩展口占位，按实际接线修改。
IO_LOC "clk50" W19;
IO_PORT "clk50" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "key_rst_n" D21;
IO_PORT "key_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "uart_rxd" L21;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_txd" M21;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 DRIVE=8;

// IMU：占位（扩展口，待接线后确定）
IO_LOC "imu_rxd" C20;
IO_PORT "imu_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "imu_txd" D20;
IO_PORT "imu_txd" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "rgmii_rxc" Y18;
IO_PORT "rgmii_rxc" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rgmii_rx_ctl" T20;
IO_PORT "rgmii_rx_ctl" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rgmii_rxd[0]" P20;
IO_LOC "rgmii_rxd[1]" N15;
IO_LOC "rgmii_rxd[2]" AA18;
IO_LOC "rgmii_rxd[3]" AB18;
IO_PORT "rgmii_rxd[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rgmii_rxd[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rgmii_rxd[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rgmii_rxd[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rgmii_txc" AB21;
IO_PORT "rgmii_txc" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "rgmii_tx_ctl" AA19;
IO_PORT "rgmii_tx_ctl" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "rgmii_txd[0]" AB20;
IO_LOC "rgmii_txd[1]" Y19;
IO_LOC "rgmii_txd[2]" AB22;
IO_LOC "rgmii_txd[3]" W20;
IO_PORT "rgmii_txd[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "eth_rst_n" P14;
IO_PORT "eth_rst_n" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "sfp1_tx_dis" R17;
IO_PORT "sfp1_tx_dis" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "sfp1_los" P15;
IO_PORT "sfp1_los" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[0]" U22;
IO_LOC "led[1]" V22;
IO_LOC "led[2]" W21;
IO_LOC "led[3]" W22;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led_cpu[0]" Y21;
IO_LOC "led_cpu[1]" Y22;
IO_LOC "led_cpu[2]" N13;
IO_LOC "led_cpu[3]" N17;
IO_LOC "led_trap" P17;
IO_PORT "led_cpu[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_cpu[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_cpu[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_cpu[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_trap" IO_TYPE=LVCMOS33 DRIVE=8;
