+#include "nav_task.h"
+#include "fixmath.h"
+
+/* A short connection from the actual pose to a normal A* cell outside the
+ * clearance margin. Both the prior and the current fine map must allow it. */
+bool nav_entry_clear(const nav_task_t *nt,int32_t x,int32_t y)
+{
+    const nav_pose_t *p=&nt->pose.cur;
+    const gmap_t *g=&nt->gm;
+    if (!g->has_prior || !nt->have_map || nt->stale || !nt->mi.inv_res) return false;
+    int dx=x-p->x,dy=y-p->y,r=nt->lp_cfg.caps.radius_mm;
+    if (nav_abs32(dx)>500 || nav_abs32(dy)>500 || dx*dx+dy*dy>500*500) return false;
+    int half=(GM_DS*65536+2*nt->mi.inv_res-1)/(2*nt->mi.inv_res)+1;
+    int ax,ay,bx,by;
+    gmap_mm_to_cell(g,&nt->mi,nav_min32(x,p->x)-r-2,nav_min32(y,p->y)-r-2,&ax,&ay);
+    gmap_mm_to_cell(g,&nt->mi,nav_max32(x,p->x)+r+2,nav_max32(y,p->y)+r+2,&bx,&by);
+    if (ax<0 || ay<0 || bx>=GM_N || by>=GM_N) return false;
+    /* Eight midpoint discs cover the swept body; inflate by half a substep
+     * and the coordinate rounding margin. An initially overlapping known
+     * coarse obstacle may only be left if the ENTIRE cell lies behind motion. */
+    int cover=r+(nav_abs32(dx)+nav_abs32(dy)+15)/16+2;
+    for (int j=ay;j<=by;j++) for (int i=ax;i<=bx;i++) {
+        int idx=j*GM_N+i;
+        if (g->prior[idx]<=NP_COST_FREE_MAX && g->grid[idx]<GM_COST_BLOCKED) continue;
+        int32_t cx,cy;
+        gmap_cell_to_mm(g,&nt->mi,i,j,&cx,&cy);
+        int hx=cx-p->x,hy=cy-p->y;
+        int sx=nav_max32(0,nav_abs32(hx)-half),sy=nav_max32(0,nav_abs32(hy)-half);
+        if (g->prior[idx]!=NP_COST_UNKNOWN && g->grid[idx]!=NP_COST_UNKNOWN &&
+            (sx || sy) &&
+            hx*dx+hy*dy+half*(nav_abs32(dx)+nav_abs32(dy))<0) continue;
+        for (int k=1;k<16;k+=2) {
+            sx=nav_max32(0,nav_abs32(hx-dx*k/16)-half);
+            sy=nav_max32(0,nav_abs32(hy-dy*k/16)-half);
+            if (sx*sx+sy*sy<=cover*cover) return false;
+        }
+    }
+    uint8_t result=motion_entry_probe(nt->map,&nt->mi,p,&nt->lp_cfg,x,y);
+    return result==MOTION_OK || result==MOTION_UNKNOWN; /* prior covers the entire sweep */
+}
+
+bool nav_entry_select(nav_task_t *nt,int *rx,int *ry)
+{
+    int sx,sy;
+    gmap_mm_to_cell(&nt->gm,&nt->mi,nt->pose.cur.x,nt->pose.cur.y,&sx,&sy);
+    if (sx<0 || sy<0 || sx>=GM_N || sy>=GM_N || nt->gm.prior[sy*GM_N+sx]>NP_COST_FREE_MAX) return false;
+    int cell=(GM_DS*65536+nt->mi.inv_res/2)/nt->mi.inv_res;
+    for (int i=0;i<81;i++) {
+        int k=(40+nt->entry_cursor+i)%81,dx=k%9-4,dy=k/9-4;
+        if (dx*dx+dy*dy>16 || (!dx && !dy)) continue;
+        int32_t x,y;
+        gmap_cell_to_mm(&nt->gm,&nt->mi,sx+dx,sy+dy,&x,&y);
+        if (!explore_goal_clear(&nt->gm,&nt->mi,x,y,(nt->as_cfg_g.hard_cells-1)*cell)) continue;
+        /* Do not introduce lateral motion just to hit a cell centre when the
+         * way out is directly away from a nearby wall. Still the same A* seed. */
+        if (!dx) x=nt->pose.cur.x;
+        if (!dy) y=nt->pose.cur.y;
+        if (!nav_entry_clear(nt,x,y)) continue;
+        nt->entry_cursor=(nt->entry_cursor+i+1)%81;
+        nt->entry_x=x;nt->entry_y=y;*rx=sx+dx;*ry=sy+dy;
+        return true;
+    }
+    return false;
+}
