+/* Actual top view:270mm long,330mm wide. Use an interior rectangle with
+ * 10mm inset; below10deg pitch/roll it remains inside the projected body.
+ * Every corner of a cell must fit. Never use the215mm safety circle here. */
+static bool inside_body(const nav_task_t *nt,int32_t gx,int32_t gy,int span)
+{
+    int32_t c=fx_cos(nt->pose.cur.yaw),s=fx_sin(nt->pose.cur.yaw);
+    for(int k=0;k<4;k++) {
+        int32_t x=(int32_t)((int64_t)(gx+((k&1)?span:0))*65536/nt->mi.inv_res)-nt->pose.cur.x;
+        int32_t y=(int32_t)((int64_t)(gy+((k&2)?span:0))*65536/nt->mi.inv_res)-nt->pose.cur.y;
+        int32_t bx=(int32_t)(((int64_t)x*c+(int64_t)y*s)/16384);
+        int32_t by=(int32_t)((-(int64_t)x*s+(int64_t)y*c)/16384);
+        if(nav_abs32(bx)>125 || nav_abs32(by)>155)return false;
+    }
+    return true;
+}
