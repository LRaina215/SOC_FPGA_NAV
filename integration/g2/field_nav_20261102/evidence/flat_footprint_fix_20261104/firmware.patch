+        for(int x=nav_max32(0,px-5);x<=nav_min32(NP_MAP_N-1,px+5);x++) {
+            int32_t gx=x+nt->mi.cx-NP_MAP_N/2,gy=y+nt->mi.cy-NP_MAP_N/2;
+            if(gx%GM_DS || gy%GM_DS || x+GM_DS>NP_MAP_N || y+GM_DS>NP_MAP_N || !inside_body(nt,gx,gy,GM_DS))continue;
+            bool clear=true;
+            for(int dy=0;dy<GM_DS;dy++)for(int dx=0;dx<GM_DS;dx++) {
+                uint8_t v=nt->map[(y+dy)*NP_MAP_N+x+dx];
+                if(v!=NP_COST_UNKNOWN && v>=GM_COST_BLOCKED)clear=false;
+            }
+            if(!clear)continue;
+            int cx=gx/GM_DS-nt->gm.ox,cy=gy/GM_DS-nt->gm.oy;
+            if(cx<0 || cy<0 || cx>=GM_N || cy>=GM_N || nt->gm.prior[cy*GM_N+cx]>=GM_COST_BLOCKED)continue;
+            int i=cy*GM_N+cx;bool hint=false;
+            for(int k=0;k<GM_VBLK;k++) {
+                int dx=cx+nt->gm.ox-nt->gm.vblk[k].gx,dy=cy+nt->gm.oy-nt->gm.vblk[k].gy,r=nt->gm.vblk[k].r;
+                if(nt->gm.vblk[k].ttl && dx*dx+dy*dy<=r*r+1)hint=true;
+            }
+            if(nt->gm.occ[i]>0 || nt->gm.cost[i]>=GM_COST_BLOCKED || hint)
+                gmap_confirm_footprint(&nt->gm,cx,cy);
+        }
+#else
+    (void)nt;(void)now;
+#endif
+}
