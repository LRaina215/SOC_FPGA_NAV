+void obstacle_clear_footprint(nav_task_t *nt,uint32_t now)
+{
+#if APP_FLAT_GROUND
+    if(!nt->have_map || nt->stale || nt->hold || !nt->gm.has_prior || !nt->mi.inv_res ||
+       (nt->mode!=NAV_MODE_GOTO && nt->mode!=NAV_MODE_SEARCH && nt->mode!=NAV_MODE_TRACK) ||
+       !nt->pose.have_odo || !nt->pose.have_att ||
+       (uint32_t)(now-nt->pose.last_odo_us)>100000u || (uint32_t)(now-nt->pose.imu_t_us)>100000u ||
+       nav_abs32((int16_t)nt->pose.cur.pitch)>1820 || nav_abs32((int16_t)nt->pose.cur.roll)>1820)return;
+    int px,py;nav_mm_to_win(&nt->mi,nt->pose.cur.x,nt->pose.cur.y,&px,&py);
+    for(int y=nav_max32(0,py-5);y<=nav_min32(NP_MAP_N-1,py+5);y++)
+        for(int x=nav_max32(0,px-5);x<=nav_min32(NP_MAP_N-1,px+5);x++) {
+            if(nt->map[y*NP_MAP_N+x]!=NP_COST_LETHAL)continue;
+            int32_t gx=x+nt->mi.cx-NP_MAP_N/2,gy=y+nt->mi.cy-NP_MAP_N/2;
+            if(!inside_body(nt,gx,gy,1))continue;
