+            nt->map[y*NP_MAP_N+x]=NP_COST_UNKNOWN;nt->footprint_cleared++;
+            if(nt->recheck_phase && gx==nt->observe_gx && gy==nt->observe_gy)
+                nt->observe_footprint_cleared=true;
