+/* Map 2 demo searches visit an area while passing through, even if a
+ * temporary observation manoeuvre was started for the previous leg. */
+#define DEMO_SEARCH_RADIUS_MM 350
+static void select_demo_leg(nav_task_t *nt,uint32_t now)
+{
+    static const int16_t route[][2]={{-110,-1220},{830,580},{2290,550},{2300,-930},{1150,-930}};
+    const nav_pose_t *p=&nt->pose.cur;
+    int dx=route[nt->demo_index][0]-p->x,dy=route[nt->demo_index][1]-p->y;
+    if ((int64_t)dx*dx+(int64_t)dy*dy<=DEMO_SEARCH_RADIUS_MM*DEMO_SEARCH_RADIUS_MM) {
+        nt->demo_index=(nt->demo_index+1)%(sizeof(route)/sizeof(route[0]));
+        if (nt->recheck_phase) {
+            nt->recheck_phase=0;nt->observe_outcome=0;nt->observe_cooldown=now+5000000u;
+        }
+        nt->path_valid=false;nt->path.n=0;nt->entry_active=false;nt->entry_cursor=0;
+        nt->recovering=false;nt->prog_x=p->x;nt->prog_y=p->y;
+        nt->prog_t_us=nt->search_t_us=now;nt->progress_travel_um=nt->pose.travel_um;
+        astar_cancel();nt->bg_done=false;
+    }
+    nt->goal_x=route[nt->demo_index][0];nt->goal_y=route[nt->demo_index][1];
+    nt->search_goal_valid=true;
+}
