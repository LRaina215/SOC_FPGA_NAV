+    static const int16_t offset[] = {0, 8192, -8192, 16384, -16384};
+    for (unsigned i = 0; i < sizeof(offset)/sizeof(offset[0]); i++) {
+        angle_t dir = (angle_t)(away + offset[i]);
+        int turn = nav_abs32(fx_angle_diff(p->yaw, dir));
