+void rc_init(rc_state_t *s){memset(s,0,sizeof(*s));}
+void rc_lens(rc_state_t *s,const uint32_t bits[9]){for(int i=0;i<9;i++)s->lens[i]=f32q(bits[i]);}
+static int floorq(int32_t x){return x>=0?x/ONE:-((int64_t)-x+ONE-1)/ONE;}
+static int ceilq(int32_t x){return -floorq(-x);}
+static bool project(const rc_state_t *s,const int32_t p[3],int32_t *u,int32_t *v){
+ if(p[0]<20)return false;
+ int32_t x=(int32_t)(((int64_t)p[1]*ONE)/p[0]),y=(int32_t)((-(int64_t)p[2]*ONE)/p[0]);
+ if(x>2*ONE || x<-2*ONE || y>ONE || y<-ONE)return false;
+ int32_t xx=qm(x,x),yy=qm(y,y),xy=qm(x,y),r=xx+yy;
+ int32_t rad=ONE+qm(r,s->lens[4]+qm(r,s->lens[5]+qm(r,s->lens[6])));
+ int32_t xd=qm(x,rad)+2*qm(s->lens[7],xy)+qm(s->lens[8],r+2*xx);
+ int32_t yd=qm(y,rad)+qm(s->lens[7],r+2*yy)+2*qm(s->lens[8],xy);
