+static bool eligible(nav_task_t *nt,int32_t gx,int32_t gy,rc_cell_t *c)
+{
+    int x=gx-nt->mi.cx+NP_MAP_N/2,y=gy-nt->mi.cy+NP_MAP_N/2;
+    if(x<0 || y<0 || x>=NP_MAP_N || y>=NP_MAP_N || nt->map[y*NP_MAP_N+x]!=NP_COST_LETHAL)return false;
+    int32_t mx,my;nav_win_to_mm(&nt->mi,x,y,&mx,&my);
+    if(fx_dist(mx-nt->pose.cur.x,my-nt->pose.cur.y)>1300)return false;
+    if(nt->gm.has_prior) {
+        int cx,cy;gmap_mm_to_cell(&nt->gm,&nt->mi,mx,my,&cx,&cy);
+        if(cx<0 || cy<0 || cx>=GM_N || cy>=GM_N || nt->gm.prior[cy*GM_N+cx]>=GM_COST_BLOCKED)return false;
+    }
+    return hal_clear_read(gx,gy,c) && c->count>=4 && c->age>=3 && c->hi-nt->pose.cur.z>40;
+}
+
+bool obstacle_observe_start(nav_task_t *nt,uint32_t now,int32_t gx,int32_t gy,uint8_t reason)
+{
+    if(nt->recheck_phase || nt->hold || !nt->have_map || nt->stale ||
+       (nt->mode!=NAV_MODE_GOTO && nt->mode!=NAV_MODE_SEARCH && nt->mode!=NAV_MODE_TRACK) ||
+       (int32_t)(now-nt->observe_cooldown)<0)return false;
+    rc_cell_t c;if(!eligible(nt,gx,gy,&c))return false;
+    int32_t x,y;nav_win_to_mm(&nt->mi,gx-nt->mi.cx+NP_MAP_N/2,gy-nt->mi.cy+NP_MAP_N/2,&x,&y);
+    int32_t dx=x-nt->pose.cur.x,dy=y-nt->pose.cur.y,d=nav_max32(1,fx_dist(dx,dy));
+    nt->observe_x=nt->pose.cur.x-(int32_t)((int64_t)dx*250/d);
+    nt->observe_y=nt->pose.cur.y-(int32_t)((int64_t)dy*250/d);
+    nt->observe_gx=gx;nt->observe_gy=gy;nt->observe_hi=c.hi;nt->observe_age=c.age;nt->observe_count=c.count;
+    nt->observe_reason=reason;nt->observe_outcome=1;nt->recheck_phase=1;
+    nt->recheck_until_us=now+35000000u;nt->observe_started++;
+    nt->path_valid=false;astar_cancel();nt->bg_done=false;nt->state=ST_BLOCKED;
+    return true;
+}
