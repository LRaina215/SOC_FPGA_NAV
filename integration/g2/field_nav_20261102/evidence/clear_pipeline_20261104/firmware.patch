+                    int32_t mx,my;int cx,cy;nav_win_to_mm(&nt->mi,x,y,&mx,&my);
+                    gmap_mm_to_cell(&nt->gm,&nt->mi,mx,my,&cx,&cy);
+                    if(cx>=0 && cy>=0 && cx<GM_N && cy<GM_N && nt->gm.grid[cy*GM_N+cx]==NP_COST_LETHAL &&
+                       (!nt->gm.has_prior || nt->gm.prior[cy*GM_N+cx]<GM_COST_BLOCKED) && confirmed_ground(nt,gx,gy)) {
+                        nt->observe_reconciled++;nt->observe_reason=3;nt->observe_outcome=2;
+                        nt->observe_gx=gx;nt->observe_gy=gy;
+                        rc_cell_t fresh;
+                        if(hal_clear_read(gx,gy,&fresh)) {
+                            nt->observe_hi=fresh.hi;nt->observe_age=fresh.age;nt->observe_count=fresh.count;
+                        } else {nt->observe_hi=-32768;nt->observe_age=255;nt->observe_count=0;}
+                        nt->path_valid=false;astar_cancel();nt->bg_done=false;return;
+                    }
+                }
+                continue;
+            }
+            int dx=x-fx,dy=y-fy,score=dx*dx+dy*dy;
+            if(score>=best)continue;
+            if(!eligible(nt,gx,gy,&c))continue;
+            if(nt->use_gmap) {
+                int32_t mx,my;int cx,cy;nav_win_to_mm(&nt->mi,x,y,&mx,&my);
+                gmap_mm_to_cell(&nt->gm,&nt->mi,mx,my,&cx,&cy);
+                if(cx<0 || cy<0 || cx>=GM_N || cy>=GM_N || nt->gm.grid[cy*GM_N+cx]!=NP_COST_LETHAL)continue;
+            }
+            best=score;bx=gx;by=gy;
+        }
+    if(best!=INT32_MAX)obstacle_observe_start(nt,now,bx,by,2);
+}
+
+static bool confirmed_ground(nav_task_t *nt,int32_t fgx,int32_t fgy)
+{
+    /* Clearing a local slot to unknown is insufficient. Confirm the complete
+     * coarse cell from fresh ground heights and the current traversability map
+     * before removing its global evidence or reporting recovery success. */
+    int32_t x,y;int cx,cy;
+    nav_win_to_mm(&nt->mi,fgx-nt->mi.cx+NP_MAP_N/2,fgy-nt->mi.cy+NP_MAP_N/2,&x,&y);
+    gmap_mm_to_cell(&nt->gm,&nt->mi,x,y,&cx,&cy);
+    int32_t gx=(cx+nt->gm.ox)*GM_DS,gy=(cy+nt->gm.oy)*GM_DS;
+    uint8_t cost=0;
+    for(int dy=0;dy<GM_DS;dy++)for(int dx=0;dx<GM_DS;dx++) {
+        int wx=gx+dx-nt->mi.cx+NP_MAP_N/2,wy=gy+dy-nt->mi.cy+NP_MAP_N/2;
+        rc_cell_t c;
+        if(wx<0 || wy<0 || wx>=NP_MAP_N || wy>=NP_MAP_N ||
+           nt->map[wy*NP_MAP_N+wx]>=GM_COST_BLOCKED || !hal_clear_read(gx+dx,gy+dy,&c) ||
+           c.count<4 || c.age>2 || c.hi-nt->pose.cur.z>=30 || c.lo-nt->pose.cur.z<=-30)return false;
+        if(nt->map[wy*NP_MAP_N+wx]>cost)cost=nt->map[wy*NP_MAP_N+wx];
+    }
+    gmap_confirm_ground(&nt->gm,cx,cy,cost);return true;
+}
+
+bool obstacle_observe_ground(nav_task_t *nt)
+{
+    return confirmed_ground(nt,nt->observe_gx,nt->observe_gy);
+}
