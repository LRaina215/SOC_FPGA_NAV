+/* Three recorded SEARCH failures showed fore/aft oscillation after the
+ * commanded speed reached zero. A command is not measured standstill.
+ * Only condition the velocity reference; goals, paths, balance/PID and the
+ * final collision veto remain outside this helper. */
+void nav_task_speed_reference(nav_task_t *nt,uint32_t now)
+{
+    if(nt->mode!=NAV_MODE_SEARCH) {nt->speed_phase=nt->speed_quiet=0;return;}
+    bool att=nt->pose.have_att && (uint32_t)(now-nt->pose.imu_t_us)<100000;
+    int pitch=nav_abs32((int16_t)nt->pose.cur.pitch);
+    if(att && pitch>ANGLE_FROM_CDEG(2000)) {
+        nt->speed_phase=4;nt->speed_quiet=0;nt->cmd=(nav_cmd_t){0};return;
+    }
+    bool fresh=nt->pose.have_odo && (uint32_t)(now-nt->pose.last_odo_us)<100000 &&
+               nt->pose.have_gyro && (uint32_t)(now-nt->pose.gyro_t_us)<100000;
+    int pr=nav_abs32(nt->pose.gyro_pr); /* angle*16/20ms;1200 ~=0.36rad/s */
+    bool quiet=fresh && att && nav_abs32(nt->pose.odo_vx)<=50 &&
+               pitch<=ANGLE_FROM_CDEG(1000) && pr<=1200;
+    int16_t wanted_v=nt->cmd.vx,wanted_w=nt->cmd.wz,previous_w=nt->speed_w_prev;
+    bool turn=wanted_v==0 && nav_abs32(wanted_w)>APP_STRAIGHT_WMAX;
+    if(turn) {
+        if(nt->speed_phase==2 && (!fresh || !att || pitch>ANGLE_FROM_CDEG(1200) || pr>2700)) {
+            nt->speed_phase=1;nt->speed_quiet=0;
+        }
+        if(nt->speed_phase!=2) {
+            if(nt->speed_phase!=1) nt->speed_quiet=0;
+            nt->speed_phase=1;
+            if(quiet && nav_abs32(previous_w)<=80) nt->speed_quiet++;
+            else nt->speed_quiet=0;
+            if(nt->speed_quiet>=2) nt->speed_phase=2;
+            else wanted_w=0;
+        }
+    } else if(wanted_v>0 && (nt->speed_phase || nav_abs32(previous_w)>APP_STRAIGHT_WMAX)) {
+        if(nt->speed_phase!=3) nt->speed_quiet=0;
+        nt->speed_phase=3;
+        if(quiet && nav_abs32(nt->pose.odo_wz)<=150 && nav_abs32(previous_w)<=80) nt->speed_quiet++;
+        else nt->speed_quiet=0;
+        if(nt->speed_quiet>=2) nt->speed_phase=nt->speed_quiet=0;
+        else {wanted_v=0;wanted_w=0;}
+    } else if(wanted_v==0) {
+        wanted_w=0;nt->speed_quiet=0;
+        nt->speed_phase=previous_w?3:0;
+    }
+    /* 80mrad/s each100ms: keep the existing0.4rad/s cap, soften its edges.
+     * Rate limit only turn/turn-exit, not normal straight heading correction. */
+    if(turn || nt->speed_phase || nav_abs32(previous_w)>APP_STRAIGHT_WMAX)
+        wanted_w=(int16_t)nav_clamp32(wanted_w,previous_w-80,previous_w+80);
+    nt->cmd.vx=wanted_v;nt->cmd.wz=(int16_t)nav_clamp32(wanted_w,-APP_TRACK_TURN_W,APP_TRACK_TURN_W);
 }
 
