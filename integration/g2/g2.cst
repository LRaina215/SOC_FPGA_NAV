// ACX750-GW5A138 导航子系统单板联调约束（引脚来自《ACX750-GW5A138开发板管脚信息表.xlsx》
// 与厂家例程 eth_udp_lookback_rgmii.cst）。IMU 串口放在 40 针扩展口 P11 的 GPIO0_0 / GPIO0_1，按实际接线修改。
IO_LOC "clk50" W19;
IO_PORT "clk50" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "key_rst_n" D21;
IO_PORT "key_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "uart_rxd" L21;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_txd" M21;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 DRIVE=8;

// IMU：扩展口 P11，GPIO0_0 = C18（FPGA 收，接 IMU 的 TX）、GPIO0_1 = C19（FPGA 发，接 IMU 的 RX）。
// C20 / D20 是拨码开关 SW7 / SW6，不能用。
IO_LOC "imu_rxd" A15;
IO_PORT "imu_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "rgmii_rxc" Y18;
IO_PORT "rgmii_rxc" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rgmii_rx_ctl" T20;
IO_PORT "rgmii_rx_ctl" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rgmii_rxd[0]" P20;
IO_LOC "rgmii_rxd[1]" N15;
IO_LOC "rgmii_rxd[2]" AA18;
IO_LOC "rgmii_rxd[3]" AB18;
IO_PORT "rgmii_rxd[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rgmii_rxd[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rgmii_rxd[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rgmii_rxd[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rgmii_txc" AB21;
IO_PORT "rgmii_txc" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "rgmii_tx_ctl" AA19;
IO_PORT "rgmii_tx_ctl" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "rgmii_txd[0]" AB20;
IO_LOC "rgmii_txd[1]" Y19;
IO_LOC "rgmii_txd[2]" AB22;
IO_LOC "rgmii_txd[3]" W20;
IO_PORT "rgmii_txd[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "eth_rst_n" P14;
IO_PORT "eth_rst_n" IO_TYPE=LVCMOS33 DRIVE=8;
// PHY 管理口（《开发板管脚信息表》ENET1_MDC / ENET1_MDIO）
IO_LOC "eth_mdc" R14;
IO_PORT "eth_mdc" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "eth_mdio" U21;
IO_PORT "eth_mdio" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;

IO_LOC "sfp1_tx_dis" R17;
IO_PORT "sfp1_tx_dis" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "sfp1_los" P15;
IO_PORT "sfp1_los" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[0]" U22;
IO_LOC "led[1]" V22;
IO_LOC "led[2]" W21;
IO_LOC "led[3]" W22;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led_cpu[0]" Y21;
IO_LOC "led_cpu[1]" Y22;
IO_LOC "led_cpu[2]" N13;
IO_LOC "led_cpu[3]" N17;
IO_LOC "led_trap" P17;
IO_PORT "led_cpu[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_cpu[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_cpu[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_cpu[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_trap" IO_TYPE=LVCMOS33 DRIVE=8;
// ACG750 GW5AT-138C PG484：50MHz 时钟及 S0 复位按键。

// GPIO0/P11 排针物理序号，非 FPGA 封装数字脚号。
// OLED SCL（用户命名 sck）：P11 pin5 -> GPIO0_4 -> F19。
IO_LOC "sck" F19;
IO_PORT "sck" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// OLED SDA：P11 pin6 -> GPIO0_5 -> F20。
IO_LOC "sda" F20;
IO_PORT "sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// OLED 驱动使用开漏输出；正常 I2C 时序仍需模块/外部 3.3V 上拉电阻。

// BMI088 I2C: SDA=P11-7(GPIO0_6/F18), SCL=P11-8(GPIO0_7/E18).
IO_LOC "BMI088_SDA" F18;
IO_PORT "BMI088_SDA" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "BMI088_SCL" E18;
IO_PORT "BMI088_SCL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 520 AB encoder pins copied from the verified competition project.
IO_LOC "M1_ENCA" D14;
IO_PORT "M1_ENCA" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "M1_ENCB" F13;
IO_PORT "M1_ENCB" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "M2_ENCA" D15;
IO_PORT "M2_ENCA" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "M2_ENCB" F14;
IO_PORT "M2_ENCB" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 520 motor drive outputs, copied from the verified original project.
IO_LOC "M1_DIR1" B20;
IO_PORT "M1_DIR1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M1_DIR2" B17;
IO_PORT "M1_DIR2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M1_PWM" D17;
IO_PORT "M1_PWM" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M2_DIR1" B18;
IO_PORT "M2_DIR1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M2_DIR2" A20;
IO_PORT "M2_DIR2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "M2_PWM" C17;
IO_PORT "M2_PWM" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Calibrated servos:1 LH,2 LK,3 RH,4 RK; P11 pins1..4.
IO_LOC "SERVO1" C18;
IO_PORT "SERVO1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "SERVO2" C19;
IO_PORT "SERVO2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "SERVO3" E19;
IO_PORT "SERVO3" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "SERVO4" D19;
IO_PORT "SERVO4" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// IR receiver pin copied from reference main.cst; idle-high NEC signal.
IO_LOC "IRIN" A21;
IO_PORT "IRIN" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Existing UART wiring: USB module RX <- P11-40; module TX -> P11-39.
IO_LOC "control_txd" A16;
IO_PORT "control_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
