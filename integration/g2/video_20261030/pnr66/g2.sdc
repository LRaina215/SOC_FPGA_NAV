# Video input clock; the 8.967 MHz LCD clock (4.3" 480x272) is derived by the reviewed PLL.
create_clock -name camera_pclk -period 20 [get_ports {CAMERA_PCLK}]
create_generated_clock -name lcd9 -source [get_ports {clk50}] -multiply_by 33 -divide_by 184 [get_pins {u_video_pll/u_pll/PLL_inst/CLKOUT1}]
# No imported video false paths. Review actual new synchronizers/payload after SYN.

# Video clock-domain crossings (audit_video_cdc.py on this netlist).
