# Async-assert/sync-release reset synchronizers (D tied 1, only stage 2 is used):
# the clk50-domain clear is asynchronous to the video clocks. Waive recovery/removal
# on these four CLEAR pins only; every other reset path stays timed.
set_false_path -to [get_pins {u_video/lcd_reset_pipe_0_s0/CLEAR}]
set_false_path -to [get_pins {u_video/lcd_reset_pipe_1_s0/CLEAR}]
set_false_path -to [get_pins {u_video/capture/pclk_reset_0_s0/CLEAR}]
set_false_path -to [get_pins {u_video/capture/pclk_reset_1_s0/CLEAR}]

report_timing -setup -max_paths 5000 -max_common_paths 1
report_timing -hold -max_paths 5000 -max_common_paths 1
report_timing -recovery -max_paths 5000 -max_common_paths 1
report_timing -removal -max_paths 5000 -max_common_paths 1
report_min_pulse_width -nworst 5000 -detail
