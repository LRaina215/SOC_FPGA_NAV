 void hal_imu_config(uint32_t baud_div)
 {
     nav_wr(NAV_IMU_BAUD_DIV, baud_div & 0xFFFFu);
+    /* While the CPU is held in reset (debug-port loads) the byte FIFO overflows but the 32-entry
+     * timestamp FIFO keeps its oldest entries, so every later burst would pop a stale time.
+     * Drain the bytes until the line has been quiet for 1 ms (a gap between bursts), then drain
+     * the timestamps, so byte bursts and timestamps start paired again. */
+    uint32_t t0 = hal_time_us(), quiet = t0;
+    while ((uint32_t)(hal_time_us() - quiet) < 1000u && (uint32_t)(hal_time_us() - t0) < 50000u)
+        if (nav_rd(NAV_IMU_RX_DATA) & NAV_IMU_RX_DATA_VALID_MASK) quiet = hal_time_us();
+    for (int i = 0; i < 64 && nav_rd(NAV_IMU_RX_TS) != 0; i++) {}
 }
 
