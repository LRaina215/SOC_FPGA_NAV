+ * 只按两套坐标定义推导，BMI088 实际安装方向须装车用手倾斜核对，错了改这三行即可。 */
+#ifndef IMU_BMI_NAV_X
+#define IMU_BMI_NAV_X(cx, cy, cz) (cy)
+#define IMU_BMI_NAV_Y(cx, cy, cz) (-(cx))
+#define IMU_BMI_NAV_Z(cx, cy, cz) (cz)
