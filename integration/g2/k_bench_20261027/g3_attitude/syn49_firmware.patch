+/* 重力单位向量（导航机身系，指向下方；水平时 (0,0,-1)）-> 与 WIT 角度帧同约定的俯仰/横滚：
+ * 姿态 R = Rz(yaw)·Ry(pitch)·Rx(roll)，机身系重力 = (sin p, -sin r cos p, -cos r cos p)，pitch>0 为低头。 */
+static void bmi_attitude(imu_parser_t *p, int32_t cx, int32_t cy, int32_t cz)
+{
+    int32_t x = IMU_BMI_NAV_X(cx, cy, cz), y = IMU_BMI_NAV_Y(cx, cy, cz), z = IMU_BMI_NAV_Z(cx, cy, cz);
+    p->pitch = fx_atan2(x, (int32_t)fx_isqrt((uint64_t)((int64_t)y * y + (int64_t)z * z)));
+    p->roll = fx_atan2(-y, -z);
+    p->yaw = 0;
+}
+
