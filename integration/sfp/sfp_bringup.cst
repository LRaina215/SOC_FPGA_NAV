IO_PORT "M1_DIR2" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "M1_PWM" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
