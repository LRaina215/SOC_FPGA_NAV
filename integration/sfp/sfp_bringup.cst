IO_PORT "M2_DIR2" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "M2_PWM" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "SERVO1" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "SERVO2" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
