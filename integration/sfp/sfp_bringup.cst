IO_LOC "uart_txd" M21;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sfp1_tx_dis" R17;
IO_PORT "sfp1_tx_dis" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sfp1_los" P15;
IO_PORT "sfp1_los" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "M1_DIR1" B20;
IO_LOC "M1_DIR2" B17;
IO_LOC "M1_PWM" D17;
IO_LOC "M2_DIR1" B18;
IO_LOC "M2_DIR2" A20;
IO_LOC "M2_PWM" C17;
IO_LOC "SERVO1" C18;
IO_LOC "SERVO2" C19;
IO_LOC "SERVO3" E19;
IO_LOC "SERVO4" D19;
